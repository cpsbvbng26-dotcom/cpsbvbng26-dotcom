  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第2節 —— 独身を、正の善からの単なる消極的な禁欲ではなく、観想の自由という高次の善へ秩序づけられたものとして扱う}
}

@misc{N-aristotle-2009,
  title = {Nicomachean Ethics},
  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第4節 —— autarkeia（自足）が eudaimonia の一部であって全体ではないこと。および第2節 —— 実践生活の必要に没入した者は、最高の幸福を構成する観想の活動の能力が減ること}
}

@misc{N-benatar-2006,
  title = {Benatar, D. (2006). Better Never to Have Been},
  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第3節 —— この議論は、新しい人を生むことが端的に善だという無反省な想定を揺るがすに足り、したがって個人が社会や種に対して生殖の生を負っているという想定も揺るがす。箇所: 非対称性の議論 —— 苦の存在は悪、快の存在は善、苦の不在は誰も享受しなくても善、快の不在は奪われる者がなければ悪ではありません}
}

@misc{N-bible-1cor7,
  title = {The Holy Bible. 1 Corinthians 7},
  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第2節 —— 独身が、分かたれない献身のために個人を自由にするという枠づけ。配偶者に配慮せねばならぬ既婚者と、単一の焦点をもつ未婚者との対比}
}

@misc{N-diogenes-1925,
