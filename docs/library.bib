@misc{N-schopenhauer-1818,
  title = {The World as Will and Representation, Vol. 1},
  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第4節 —— あらゆる意志作用を、単一の、盲目で、満たされることのない形而上学的な意志の現れとして扱い、個別の満足はつねに一時的で、ただちに新たな渇望に取って代わられます。および、意志の否定と禁欲による放棄が、苦の源である渇望への露出を減らす最高の戦略のひとつであること}
}

@misc{N-schopenhauer-1844,
  title = {The Metaphysics of Sexual},
  note  = {哲学三篇の参考文献欄の文字列のまま。確かめた度合: 原典未確認。論文 N。支えている主張: 第4節 —— 性的欲望は、主として個人の利益のためではなく種に奉仕して働きます。情欲の強さは、意志が生殖を確保するための策略であり、それが動員する個人の幸福には実質的に無関心です}
}
